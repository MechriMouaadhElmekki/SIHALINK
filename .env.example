# ============================================================
# SIHALINK Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# --- Supabase (Public - safe to expose to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (Private - NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SIHALINK
NEXT_PUBLIC_DEMO_MODE=true

# --- Sentry Error Monitoring ---
# Create a project at https://sentry.io and copy the DSN from Settings > Client Keys
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (used by sentry.client.config.ts)
# SENTRY_DSN is server-only (used by sentry.server.config.ts + sentry.edge.config.ts)
# Both can be the same DSN value — having two vars lets you disable client-side
# reporting separately from server-side if needed.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source map upload during CI builds (Settings > Auth Tokens)
SENTRY_AUTH_TOKEN=
# Organisation slug and project slug from your Sentry dashboard URL:
# https://sentry.io/organizations/<SENTRY_ORG>/projects/<SENTRY_PROJECT>/
SENTRY_ORG=sihalink
SENTRY_PROJECT=sihalink-web

# --- Map Provider (abstracted - configure when ready) ---
# MAP_PROVIDER=openstreetmap
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Email Provider (abstracted) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=noreply@sihalink.dz

# --- SMS Provider (abstracted) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Push Notifications (abstracted) ---
# PUSH_PROVIDER=onesignal
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# --- Emergency Dispatch (abstracted - MockProvider by default) ---
# EMERGENCY_DISPATCH_PROVIDER=mock
# CIVIL_PROTECTION_API_URL=
# CIVIL_PROTECTION_API_KEY=
